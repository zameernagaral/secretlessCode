PORT=4000
CORS_ORIGIN=*
CLONE_TIMEOUT_MS=25000
SCAN_TIMEOUT_MS=25000
MAX_REPO_SIZE_MB=60
GITLEAKS_PATH=gitleaks

# ── GitHub App PR Scanner ──────────────────────────────────────────────────────
# Create your app at: https://github.com/settings/apps/new
# Required permissions: Pull Requests (Read & Write), Commit Statuses (Read & Write)
# Required events: pull_request
GITHUB_APP_ID=                          # e.g. 12345678
GITHUB_APP_PRIVATE_KEY=                 # Full PEM key with \n for newlines: "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=                  # Random secret string you set when creating the GitHub App

# ── Slack / Discord Notifications ─────────────────────────────────────────────
# Both are optional. Remove or leave blank to disable that channel.
# Notifications fire on every scan that finds secrets (and optionally on clean scans too).

# Slack: Create an Incoming Webhook at https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=                      # e.g. https://hooks.slack.com/services/T.../B.../...

# Discord: Channel Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=                    # e.g. https://discord.com/api/webhooks/123456/abcdef...

# Set to "true" to also send a notification when a scan finds 0 secrets (default: false)
NOTIFY_ON_CLEAN_SCANS=false
