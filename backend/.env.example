PORT=4000
CORS_ORIGIN=*
CLONE_TIMEOUT_MS=25000
SCAN_TIMEOUT_MS=25000
MAX_REPO_SIZE_MB=60

# ── Scanning Engine ────────────────────────────────────────────────────────────
# Controls which scan engine is used. Options:
#   "auto"       — Try Gitleaks → TruffleHog → builtin (best available)  [default]
#   "gitleaks"   — Use Gitleaks v8 CLI only
#   "trufflehog" — Use TruffleHog v3 CLI only
#   "both"       — Run both engines and merge + deduplicate findings
SCAN_ENGINE=auto

GITLEAKS_PATH=gitleaks       # Path to gitleaks binary (or just "gitleaks" if on PATH)
TRUFFLEHOG_PATH=trufflehog   # Path to trufflehog binary (or just "trufflehog" if on PATH)


# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Global limiter — applies to all routes (except GitHub webhook)
RATE_GLOBAL_MAX=200               # max requests per window per IP
RATE_GLOBAL_WINDOW_MS=900000      # window in ms (default: 15 minutes)

# Scan limiter — POST /api/scan (most expensive endpoint)
RATE_SCAN_MAX=5                   # max scans per window per IP
RATE_SCAN_WINDOW_MS=3600000       # window in ms (default: 1 hour)

# Health check limiter — GET /api/health
RATE_HEALTH_MAX=60                # max health pings per minute per IP
RATE_HEALTH_WINDOW_MS=60000       # window in ms (default: 1 minute)


# ── GitHub App PR Scanner ──────────────────────────────────────────────────────
# Create your app at: https://github.com/settings/apps/new
# Required permissions: Pull Requests (Read & Write), Commit Statuses (Read & Write)
# Required events: pull_request
GITHUB_APP_ID=                          # e.g. 12345678
GITHUB_APP_PRIVATE_KEY=                 # Full PEM key with \n for newlines: "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=                  # Random secret string you set when creating the GitHub App

# ── Slack / Discord Notifications ─────────────────────────────────────────────
# Both are optional. Remove or leave blank to disable that channel.
# Notifications fire on every scan that finds secrets (and optionally on clean scans too).

# Slack: Create an Incoming Webhook at https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=                      # e.g. https://hooks.slack.com/services/T.../B.../...

# Discord: Channel Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=                    # e.g. https://discord.com/api/webhooks/123456/abcdef...

# Set to "true" to also send a notification when a scan finds 0 secrets (default: false)
NOTIFY_ON_CLEAN_SCANS=false

# ── Cloud Storage for Scan Reports (Optional) ─────────────────────────────────
# Reports are always generated safely (masked credentials only).
# STORAGE_PROVIDER options: "r2" (Cloudflare), "s3" (AWS), "supabase", or "none"
STORAGE_PROVIDER=none
STORAGE_PRESIGN_EXPIRY_SEC=3600

# >> For AWS S3 or Cloudflare R2
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# >> For Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=scan-reports

