# Copy this file to .env and fill in your values
# docker compose will automatically load .env from the root directory

# ── GitHub App PR Scanner ──────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Slack / Discord Notifications ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
NOTIFY_ON_CLEAN_SCANS=false

# ── Cloud Storage for Scan Reports (Optional) ─────────────────────────────────
# STORAGE_PROVIDER options: "r2", "s3", "supabase", or "none"
STORAGE_PROVIDER=none
STORAGE_PRESIGN_EXPIRY_SEC=3600

STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=scan-reports
