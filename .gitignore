# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
frontend/.next/
frontend/out/

# Environment files — NEVER commit real .env files
.env
.env.*
!.env.example          # .env.example is safe — it's the template
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*
!frontend/.env.example

# Key / cert files — catch leaked keys before they reach git
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
private_key*
secret_key*

# Scan report artifacts (may contain masked finding paths)
secretless-report-*.json
secretless-pr-report-*.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Temporary scan directories (Security critical: never commit temp clones)
tmp/
temp-scans/
backend/temp-scans/
backend/tmp/

# OS Files
.DS_Store
Thumbs.db

# IDE Files
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/

# Docker
.docker/
docker-compose.override.yml
